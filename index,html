                        <button type="button" title="이름 바꾸기" class="rename-session-btn p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg opacity-80 sm:opacity-0 group-hover:opacity-100 transition">
