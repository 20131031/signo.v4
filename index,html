<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>시그노 (SIGNO) - AI 수학 문제풀이 튜터</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Noto Sans KR -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- KaTeX for Math Rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    <!-- Marked.js for Markdown Parsing -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Inter', 'Noto Sans KR', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .prose-math h1, .prose-math h2, .prose-math h3 {
            font-weight: 700;
            color: #1e293b;
            margin-top: 1.25rem;
            margin-bottom: 0.5rem;
        }
        .prose-math h3 {
            font-size: 1.05rem;
            display: flex;
            align-items: center;
            gap: 0.375rem;
            color: #4f46e5;
        }
        .prose-math p {
            margin-bottom: 0.75rem;
            line-height: 1.65;
            color: #334155;
        }
        .prose-math ul, .prose-math ol {
            margin-left: 1.25rem;
            margin-bottom: 0.75rem;
            color: #334155;
        }
        .prose-math ul { list-style-type: disc; }
        .prose-math ol { list-style-type: decimal; }
        .prose-math li { margin-bottom: 0.35rem; }
        .prose-math strong { color: #0f172a; font-weight: 600; }
        .prose-math blockquote {
            border-left: 4px solid #6366f1;
            background-color: #eef2ff;
            padding: 0.75rem 1rem;
            border-radius: 0 0.5rem 0.5rem 0;
            margin: 0.75rem 0;
            color: #3730a3;
        }
        .prose-math code {
            background-color: #f1f5f9;
            padding: 0.15rem 0.35rem;
            border-radius: 0.25rem;
            font-size: 0.875em;
            color: #e11d48;
        }
        .katex-display {
            overflow-x: auto;
            overflow-y: hidden;
            padding: 0.5rem 0;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 h-screen flex flex-col overflow-hidden">

    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-slate-200 px-3 sm:px-5 py-2.5 flex items-center justify-between gap-2 shrink-0 shadow-sm z-20">
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            <!-- Chat List Drawer Toggle Button -->
            <button id="toggleSidebarBtn" type="button" title="채팅 목록 열기" class="p-2 text-slate-600 hover:text-indigo-600 hover:bg-slate-100 rounded-xl transition shrink-0">
                <i data-lucide="panel-left" class="w-5 h-5"></i>
            </button>

            <!-- Home / Sigma Logo Button -->
            <button id="homeLogoBtn" type="button" title="홈 화면으로 이동" class="flex items-center gap-2 text-left group focus:outline-none shrink-0">
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-indigo-600 group-hover:bg-indigo-700 flex items-center justify-center text-white font-bold text-lg sm:text-xl shadow-md shadow-indigo-200 transition select-none shrink-0">
                    &Sigma;
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                    <span class="font-bold text-slate-900 text-base sm:text-lg leading-none group-hover:text-indigo-600 transition whitespace-nowrap">시그노</span>
                    <span class="hidden md:inline-block text-[11px] font-semibold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-600 border border-indigo-100 whitespace-nowrap">SIGNO</span>
                </div>
            </button>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
            <!-- Level Selector -->
            <select id="levelSelect" class="text-xs sm:text-sm bg-slate-100 hover:bg-slate-200/70 text-slate-700 font-medium rounded-xl px-2 sm:px-3 py-2 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition cursor-pointer shrink-0">
                <option value="auto">자동 수준</option>
                <option value="elementary">초등 눈높이</option>
                <option value="middle">중등 눈높이</option>
                <option value="high">고등 눈높이</option>
            </select>

            <!-- New Chat Button -->
            <button id="newChatBtn" type="button" title="새 채팅 시작" class="flex items-center gap-1.5 px-2.5 sm:px-3 py-2 text-xs sm:text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl transition shadow-xs shrink-0">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span class="whitespace-nowrap">새 채팅</span>
            </button>
        </div>
    </header>

    <!-- Chat History Sidebar Drawer & Backdrop -->
    <div id="sidebarBackdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-30 hidden transition-opacity"></div>
    <aside id="chatSidebar" class="fixed top-0 left-0 bottom-0 w-72 sm:w-80 bg-white border-r border-slate-200 z-40 transform -translate-x-full transition-transform duration-250 ease-out flex flex-col shadow-2xl">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-base select-none">
                    &Sigma;
                </div>
                <span class="font-bold text-slate-900 text-base">채팅 목록</span>
            </div>
            <button id="closeSidebarBtn" type="button" class="p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="p-3 border-b border-slate-100">
            <button id="sidebarNewChatBtn" type="button" class="w-full py-2.5 px-3 bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-semibold rounded-xl flex items-center justify-center gap-2 shadow-sm transition">
                <i data-lucide="message-square-plus" class="w-4 h-4"></i>
                <span>새 채팅 시작하기</span>
            </button>
        </div>

        <div id="sessionListContainer" class="flex-1 overflow-y-auto p-3 space-y-1.5"></div>

        <div class="p-3 border-t border-slate-100 text-[11px] text-slate-400 text-center bg-slate-50/70">
            고정 · 이름 바꾸기 · 삭제 지원
        </div>
    </aside>

    <!-- Custom Rename Modal -->
    <div id="renameModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-sm w-full p-5 shadow-2xl border border-slate-200">
            <h3 class="text-base font-bold text-slate-900 mb-1">채팅 이름 바꾸기</h3>
            <p class="text-xs text-slate-500 mb-3">구분하기 쉬운 단원명이나 문제 제목으로 변경하세요.</p>
            <form id="renameForm" class="space-y-3">
                <input type="text" id="renameInput" required maxlength="40" placeholder="새 채팅 이름 입력"
                    class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
                <div class="flex items-center justify-end gap-2">
                    <button type="button" id="cancelRenameBtn" class="px-3.5 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition">취소</button>
                    <button type="submit" class="px-4 py-2 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl transition">저장</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Custom Toast / Alert Box -->
    <div id="toastContainer" class="fixed top-16 left-1/2 -translate-x-1/2 z-50 pointer-events-none flex flex-col gap-2 w-full max-w-md px-4"></div>

    <!-- Main Chat & Workspace Area -->
    <main id="chatContainer" class="flex-1 overflow-y-auto px-4 py-6 space-y-6 max-w-4xl w-full mx-auto">
        <!-- Welcome Screen / Empty State -->
        <div id="welcomeBanner" class="bg-white rounded-2xl border border-slate-200/80 p-5 sm:p-7 shadow-sm space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white shrink-0 shadow-md">
                    <i data-lucide="sparkles" class="w-6 h-6"></i>
                </div>
                <div>
                    <h2 class="text-lg sm:text-xl font-bold text-slate-900">시그노(SIGNO)에게 수학 문제를 바로 물어보세요!</h2>
                    <p class="text-sm text-slate-600 mt-1">
                        문제 사진을 찍어 올리거나, 화면 캡처 후 <kbd class="px-1.5 py-0.5 text-xs font-semibold bg-slate-100 border border-slate-300 rounded">Ctrl+V</kbd>로 붙여넣기만 하면 수식과 도형을 분석해 <strong>핵심 개념부터 정답까지</strong> 차근차근 풀어드립니다.
                    </p>
                </div>
            </div>

            <!-- Quick Example Prompts -->
            <div class="pt-2 border-t border-slate-100">
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2.5">예시 질문으로 바로 테스트하기</p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                    <button type="button" class="example-btn text-left p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 transition group"
                        data-prompt="이차방정식 x² - 5x + 6 = 0 을 인수분해와 근의 공식 두 가지 방법으로 각각 풀어주고 판별식의 의미도 설명해줘.">
                        <span class="text-[11px] font-bold text-indigo-600 block mb-0.5">중3 · 방정식</span>
                        <span class="text-xs text-slate-700 group-hover:text-slate-900 line-clamp-2">$x^2 - 5x + 6 = 0$ 두 가지 풀이법 비교</span>
                    </button>

                    <button type="button" class="example-btn text-left p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 transition group"
                        data-prompt="함수 f(x) = x³ - 3x² + 2 의 극댓값과 극솟값을 미분을 이용해 구하고, 그래프의 개형을 설명해줘.">
                        <span class="text-[11px] font-bold text-purple-600 block mb-0.5">고2 · 미적분</span>
                        <span class="text-xs text-slate-700 group-hover:text-slate-900 line-clamp-2">삼차함수 $f(x)=x^3-3x^2+2$ 의 극값과 개형</span>
                    </button>

                    <button type="button" class="example-btn text-left p-3 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 transition group"
                        data-prompt="사과와 귤이 합쳐서 15개 있습니다. 사과가 귤보다 3개 더 많을 때, 사과는 몇 개인지 초등학생도 이해하기 쉽게 식을 세워 풀어줘.">
                        <span class="text-[11px] font-bold text-emerald-600 block mb-0.5">초등 · 문장제</span>
                        <span class="text-xs text-slate-700 group-hover:text-slate-900 line-clamp-2">합과 차를 이용한 문장제 문제 풀이</span>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Bottom Input Area -->
    <footer class="bg-white border-t border-slate-200 px-4 py-3 shrink-0">
        <div class="max-w-4xl mx-auto">
            <!-- Image Preview Bar -->
            <div id="imagePreviewContainer" class="hidden mb-3 p-2.5 bg-indigo-50/70 border border-indigo-200 rounded-xl flex items-center justify-between">
                <div class="flex items-center gap-3 overflow-hidden">
                    <img id="imagePreviewThumb" src="" alt="업로드된 수학 문제 미리보기" class="w-14 h-14 object-cover rounded-lg border border-indigo-200 bg-white shrink-0">
                    <div class="min-w-0">
                        <p id="imageFileName" class="text-xs font-semibold text-indigo-950 truncate">problem_image.png</p>
                        <p class="text-[11px] text-indigo-600 mt-0.5">문제 사진이 첨부되었습니다. 바로 풀이 버튼을 누르거나 질문을 입력하세요.</p>
                    </div>
                </div>
                <button id="removeImageBtn" type="button" class="p-1.5 text-indigo-500 hover:text-rose-600 hover:bg-white rounded-lg transition shrink-0" title="이미지 제거">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <!-- Input Box -->
            <form id="solveForm" class="relative flex items-end gap-2 bg-slate-100 border border-slate-200 focus-within:border-indigo-500 focus-within:bg-white focus-within:ring-2 focus-within:ring-indigo-500/20 rounded-2xl p-2 transition">
                <input type="file" id="imageInput" accept="image/*" class="hidden">

                <!-- Upload Image Button -->
                <button type="button" id="uploadBtn" title="문제 사진 업로드 (또는 Ctrl+V 붙여넣기)"
                    class="p-2.5 bg-white hover:bg-indigo-50 text-indigo-600 border border-slate-200 hover:border-indigo-300 rounded-xl transition shrink-0 flex items-center gap-1.5 shadow-2xs">
                    <i data-lucide="image-plus" class="w-5 h-5"></i>
                    <span class="text-xs font-semibold">사진 삽입</span>
                </button>

                <!-- Textarea -->
                <textarea id="promptInput" rows="1" placeholder="수학 문제를 입력하거나 문제 사진을 올려주세요... (Shift+Enter 줄바꿈)"
                    class="w-full bg-transparent text-sm text-slate-800 placeholder-slate-400 resize-none py-2.5 px-1 focus:outline-none max-h-36 leading-relaxed"></textarea>

                <!-- Submit Button -->
                <button type="submit" id="submitBtn"
                    class="p-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white rounded-xl transition shrink-0 shadow-sm flex items-center gap-1.5 px-3.5">
                    <span class="text-xs font-semibold hidden sm:inline">풀이 시작</span>
                    <i data-lucide="send" class="w-4 h-4"></i>
                </button>
            </form>

            <div class="flex items-center justify-between mt-1.5 px-1 text-[11px] text-slate-400">
                <span>💡 팁: 캡처한 문제 이미지를 입력창에 바로 <strong class="text-slate-500">붙여넣기(Ctrl+V)</strong>하거나 드래그해서 넣을 수 있어요.</span>
                <span class="hidden sm:inline">시그노 (SIGNO) AI 수학 엔진</span>
            </div>
        </div>
    </footer>

    <!-- Drag & Drop Overlay -->
    <div id="dropOverlay" class="fixed inset-0 bg-indigo-900/40 backdrop-blur-xs z-50 hidden items-center justify-center p-4 pointer-events-none">
        <div class="bg-white rounded-3xl p-8 max-w-sm w-full text-center shadow-2xl border-2 border-dashed border-indigo-500">
            <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <i data-lucide="upload-cloud" class="w-8 h-8"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900">여기에 문제 이미지를 놓으세요</h3>
            <p class="text-xs text-slate-500 mt-1">PNG, JPG, WEBP 등 모든 이미지 지원</p>
        </div>
    </div>

    <script>
        lucide.createIcons();

        // Storage Keys & App State
        const STORAGE_KEY = 'signo_local_sessions_v1';
        const PROXY_ENDPOINT = "https://signo-proxy.yxuxeung.workers.dev";
        const apiKey = "";

        let sessions = loadSessionsFromStorage();
        let currentSessionId = null;
        let renamingSessionId = null;
        let currentImageBase64 = null;
        let currentImageMimeType = null;
        let conversationHistory = [];
        let isGenerating = false;

        // DOM Elements
        const chatContainer = document.getElementById('chatContainer');
        const welcomeBanner = document.getElementById('welcomeBanner');
        const solveForm = document.getElementById('solveForm');
        const promptInput = document.getElementById('promptInput');
        const imageInput = document.getElementById('imageInput');
        const uploadBtn = document.getElementById('uploadBtn');
        const imagePreviewContainer = document.getElementById('imagePreviewContainer');
        const imagePreviewThumb = document.getElementById('imagePreviewThumb');
        const imageFileName = document.getElementById('imageFileName');
        const removeImageBtn = document.getElementById('removeImageBtn');
        const submitBtn = document.getElementById('submitBtn');
        const levelSelect = document.getElementById('levelSelect');
        const dropOverlay = document.getElementById('dropOverlay');
        const toastContainer = document.getElementById('toastContainer');

        // Navigation & Sidebar Elements
        const homeLogoBtn = document.getElementById('homeLogoBtn');
        const newChatBtn = document.getElementById('newChatBtn');
        const toggleSidebarBtn = document.getElementById('toggleSidebarBtn');
        const closeSidebarBtn = document.getElementById('closeSidebarBtn');
        const sidebarBackdrop = document.getElementById('sidebarBackdrop');
        const chatSidebar = document.getElementById('chatSidebar');
        const sidebarNewChatBtn = document.getElementById('sidebarNewChatBtn');
        const sessionListContainer = document.getElementById('sessionListContainer');

        // Rename Modal Elements
        const renameModal = document.getElementById('renameModal');
        const renameForm = document.getElementById('renameForm');
        const renameInput = document.getElementById('renameInput');
        const cancelRenameBtn = document.getElementById('cancelRenameBtn');

        window.addEventListener('DOMContentLoaded', () => {
            renderSessionList();
            renderMathInElement(document.body, {
                delimiters: [
                    { left: '$$', right: '$$', display: true },
                    { left: '$', right: '$', display: false }
                ],
                throwOnError: false
            });
        });

        // LocalStorage Helpers
        function loadSessionsFromStorage() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                const parsed = raw ? JSON.parse(raw) : [];
                return Array.isArray(parsed) ? parsed : [];
            } catch (e) {
                return [];
            }
        }

        function saveSessionsToStorage() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(sessions));
            } catch (e) {
                try {
                    const lightweight = sessions.map((s, idx) => ({
                        ...s,
                        messages: s.messages.map(m => idx > 2 ? { ...m, imageDataUrl: null } : m)
                    }));
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(lightweight));
                } catch (err) {}
            }
        }

        // Sidebar Open / Close Controls
        function openSidebar() {
            renderSessionList();
            sidebarBackdrop.classList.remove('hidden');
            chatSidebar.classList.remove('-translate-x-full');
        }

        function closeSidebar() {
            sidebarBackdrop.classList.add('hidden');
            chatSidebar.classList.add('-translate-x-full');
        }

        toggleSidebarBtn.addEventListener('click', openSidebar);
        closeSidebarBtn.addEventListener('click', closeSidebar);
        sidebarBackdrop.addEventListener('click', closeSidebar);

        // Home Logo & New Chat Actions
        function startNewChat(showNotification = false) {
            if (isGenerating) {
                showToast('풀이를 생성하는 중에는 이동할 수 없습니다.', 'error');
                return;
            }
            currentSessionId = null;
            conversationHistory = [];
            clearImageAttachment();
            promptInput.value = '';
            promptInput.style.height = 'auto';

            chatContainer.innerHTML = '';
            chatContainer.appendChild(welcomeBanner);
            welcomeBanner.classList.remove('hidden');
            closeSidebar();
            renderSessionList();

            if (showNotification) {
                showToast('새 채팅을 시작합니다.');
            }
        }

        homeLogoBtn.addEventListener('click', () => startNewChat(false));
        newChatBtn.addEventListener('click', () => startNewChat(true));
        sidebarNewChatBtn.addEventListener('click', () => startNewChat(true));

        // Pin, Rename, Delete Session Functions
        function togglePinSession(sessionId) {
            const target = sessions.find(s => s.id === sessionId);
            if (!target) return;
            target.pinned = !target.pinned;
            saveSessionsToStorage();
            renderSessionList();
            showToast(target.pinned ? '채팅을 상단에 고정했습니다.' : '채팅 고정을 해제했습니다.');
        }

        function openRenameModal(sessionId) {
            const target = sessions.find(s => s.id === sessionId);
            if (!target) return;
            renamingSessionId = sessionId;
            renameInput.value = target.title;
            renameModal.classList.remove('hidden');
            renameModal.classList.add('flex');
            setTimeout(() => {
                renameInput.focus();
                renameInput.select();
            }, 30);
        }

        function closeRenameModal() {
            renamingSessionId = null;
            renameModal.classList.add('hidden');
            renameModal.classList.remove('flex');
        }

        cancelRenameBtn.addEventListener('click', closeRenameModal);
        renameModal.addEventListener('click', (e) => {
            if (e.target === renameModal) closeRenameModal();
        });

        renameForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const newTitle = renameInput.value.trim();
            if (!newTitle || !renamingSessionId) return;

            const target = sessions.find(s => s.id === renamingSessionId);
            if (target) {
                target.title = newTitle;
                saveSessionsToStorage();
                renderSessionList();
                showToast('채팅 이름이 변경되었습니다.', 'success');
            }
            closeRenameModal();
        });

        function deleteSession(sessionId) {
