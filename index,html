                                ${escapeHtml(session.title)}
                            </p>
                        </div>
                        <p class="text-[10px] text-slate-400 mt-0.5">${dateStr}</p>
                    </div>
                    <div class="flex items-center gap-0.5 shrink-0">
                        <button type="button" title="${isPinned ? '고정 해제' : '상단 고정'}" class="pin-session-btn p-1.5 rounded-lg transition ${
                            isPinned
                                ? 'text-amber-500 hover:bg-amber-100/70'
                                : 'text-slate-400 hover:text-amber-600 hover:bg-slate-100 opacity-80 sm:opacity-0 group-hover:opacity-100'
                        }">
