            conversationHistory.push({
                role: 'user',
                parts: userParts
            });

            isGenerating = true;
            submitBtn.disabled = true;
            const loadingId = appendLoadingBubble();

            try {
                const aiResponseText = await callGeminiWithRetry(conversationHistory);
                document.getElementById(loadingId)?.remove();

                conversationHistory.push({
                    role: 'model',
                    parts: [{ text: aiResponseText }]
                });

                appendAIMessage(aiResponseText);
                upsertSessionMessage(userText, textToSend, imageDataUrlToDisplay, aiResponseText);
            } catch (error) {
                document.getElementById(loadingId)?.remove();
                conversationHistory.pop();

                const errMsg = error?.message || '';
                if (errMsg.includes('500')) {
                    showToast('Cloudflare 서버에 GEMINI_API_KEY가 등록되지 않았습니다.', 'error');
                } else if (errMsg.includes('400') || errMsg.includes('403')) {
                    showToast('API 키가 올바르지 않습니다. Cloudflare의 GEMINI_API_KEY를 확인해 주세요.', 'error');
                } else {
                    showToast(`오류가 발생했습니다 (${errMsg || '연결 실패'}). 잠시 후 다시 시도해 주세요.`, 'error');
                }
            } finally {
                isGenerating = false;
                submitBtn.disabled = false;
                promptInput.focus();
