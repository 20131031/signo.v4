            const textToSend = userText || "이 이미지에 있는 수학 문제를 분석하고 단계별로 자세히 풀이해 주세요.";
            const imageBase64ToSend = currentImageBase64;
            const imageMimeToSend = currentImageMimeType;
            const imageDataUrlToDisplay = imageBase64ToSend ? imagePreviewThumb.src : null;

            promptInput.value = '';
            promptInput.style.height = 'auto';
            clearImageAttachment();

            appendUserMessage(userText, imageDataUrlToDisplay);

            const userParts = [{ text: textToSend }];
            if (imageBase64ToSend && imageMimeToSend) {
                userParts.push({
                    inlineData: {
                        mimeType: imageMimeToSend,
                        data: imageBase64ToSend
                    }
                });
