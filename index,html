        function loadSession(sessionId) {
            if (isGenerating) {
                showToast('풀이를 생성하는 중에는 전환할 수 없습니다.', 'error');
                return;
            }
            const target = sessions.find(s => s.id === sessionId);
            if (!target) return;

            currentSessionId = target.id;
            conversationHistory = [];
            clearImageAttachment();

            chatContainer.innerHTML = '';
            welcomeBanner.classList.add('hidden');

            target.messages.forEach(msg => {
                if (msg.role === 'user') {
                    appendUserMessage(msg.text, msg.imageDataUrl, false);
                    conversationHistory.push({
                        role: 'user',
                        parts: [{ text: msg.apiText || msg.text || '수학 문제 풀이' }]
                    });
                } else if (msg.role === 'model') {
                    appendAIMessage(msg.text, false);
                    conversationHistory.push({
                        role: 'model',
                        parts: [{ text: msg.text }]
                    });
                }
            });

            closeSidebar();
            renderSessionList();
            scrollToBottom();
        }

        function upsertSessionMessage(userDisplayText, userApiText, imageDataUrl, aiResponseText) {
            const now = Date.now();
            if (!currentSessionId) {
                currentSessionId = 'session-' + now;
                const rawTitle = (userDisplayText || '사진 수학 문제 풀이').replace(/\s+/g, ' ').trim();
                const title = rawTitle.length > 26 ? rawTitle.slice(0, 26) + '...' : rawTitle;
                sessions.unshift({
                    id: currentSessionId,
                    title: title,
                    pinned: false,
                    updatedAt: now,
                    messages: []
                });
            }

            const session = sessions.find(s => s.id === currentSessionId);
            if (session) {
                session.updatedAt = now;
                session.messages.push(
                    { role: 'user', text: userDisplayText, apiText: userApiText, imageDataUrl: imageDataUrl },
                    { role: 'model', text: aiResponseText }
                );
                saveSessionsToStorage();
            }

            renderSessionList();
        }

